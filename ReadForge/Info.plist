<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	
	<!-- Privacy and Usage Descriptions -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>ReadForge needs access to import and manage your PDF documents for offline reading and audio conversion.</string>
	
	<key>NSMicrophoneUsageDescription</key>
	<string>ReadForge does not use the microphone. This permission is required by the system for audio playback functionality.</string>
	
	<key>NSFileProviderDomainUsageDescription</key>
	<string>ReadForge needs to access your documents to convert them into audio format for offline listening.</string>
	
	<!-- Security Settings -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	
	<!-- App Capabilities -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
		<string>audio-playback</string>
	</array>
	
	<!-- Supported Document Types -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>pdf</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array/>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>epub</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array/>
			<key>CFBundleTypeName</key>
			<string>EPUB Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>txt</string>
			</array>
			<key>CFBundleTypeIconFiles</key>
			<array/>
			<key>CFBundleTypeName</key>
			<string>Text Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
	</array>
	
	<!-- App Store and Distribution -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	
	<!-- Performance and Memory -->
	<key>UIRequiresFullScreen</key>
	<false/>
	
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	
	<!-- Backup and Cloud -->
	<key>UIFileSharingEnabled</key>
	<true/>
	
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	
	<!-- Accessibility -->
	<key>UIAccessibilityTraits</key>
	<array>
		<string>UIAccessibilityTraitPlaysSound</string>
	</array>
	
	<!-- iOS Version Requirements -->
	<key>MinimumOSVersion</key>
	<string>17.0</string>
</dict>
</plist>
